{
  "$description": "SlateOS design tokens. Three layers: primitive (raw values), semantic (meaning, per theme), component (per-component decisions).",
  "primitive": {
    "color": {
      "gray": {
        "0": { "$value": "#ffffff", "$type": "color" },
        "50": { "$value": "#f8f9fb", "$type": "color" },
        "100": { "$value": "#f1f3f6", "$type": "color" },
        "200": { "$value": "#e4e7ec", "$type": "color" },
        "300": { "$value": "#d0d5dd", "$type": "color" },
        "400": { "$value": "#98a2b3", "$type": "color" },
        "500": { "$value": "#667085", "$type": "color" },
        "600": { "$value": "#4b5565", "$type": "color" },
        "700": { "$value": "#364152", "$type": "color" },
        "800": { "$value": "#202939", "$type": "color" },
        "900": { "$value": "#121926", "$type": "color" },
        "950": { "$value": "#0b101a", "$type": "color" }
      },
      "accent": {
        "100": { "$value": "#e5eafc", "$type": "color" },
        "300": { "$value": "#a3b3f5", "$type": "color" },
        "400": { "$value": "#7b93f0", "$type": "color" },
        "600": { "$value": "#2f4fd8", "$type": "color" },
        "700": { "$value": "#243fb0", "$type": "color" },
        "900": { "$value": "#1a2557", "$type": "color" }
      },
      "success": {
        "100": { "$value": "#e3f4ea", "$type": "color" },
        "400": { "$value": "#5fcf94", "$type": "color" },
        "600": { "$value": "#17703f", "$type": "color" },
        "900": { "$value": "#0f2e20", "$type": "color" }
      },
      "danger": {
        "100": { "$value": "#fdeceb", "$type": "color" },
        "400": { "$value": "#f2796f", "$type": "color" },
        "600": { "$value": "#b42318", "$type": "color" },
        "900": { "$value": "#3b1512", "$type": "color" }
      }
    },
    "space": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.5rem", "$type": "dimension" },
      "6": { "$value": "2rem", "$type": "dimension" },
      "8": { "$value": "3rem", "$type": "dimension" },
      "10": { "$value": "4rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "4px", "$type": "dimension" },
      "md": { "$value": "6px", "$type": "dimension" },
      "lg": { "$value": "10px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "size": {
      "control-sm": { "$value": "2rem", "$type": "dimension" },
      "control-md": { "$value": "2.5rem", "$type": "dimension" },
      "control-lg": { "$value": "3rem", "$type": "dimension" }
    },
    "font": {
      "family-sans": { "$value": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily" },
      "family-mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" },
      "size-xs": { "$value": "0.75rem", "$type": "dimension" },
      "size-sm": { "$value": "0.875rem", "$type": "dimension" },
      "size-md": { "$value": "1rem", "$type": "dimension" },
      "size-lg": { "$value": "1.125rem", "$type": "dimension" },
      "size-xl": { "$value": "1.5rem", "$type": "dimension" },
      "size-2xl": { "$value": "2.25rem", "$type": "dimension" },
      "weight-regular": { "$value": "400", "$type": "fontWeight" },
      "weight-medium": { "$value": "500", "$type": "fontWeight" },
      "weight-semibold": { "$value": "600", "$type": "fontWeight" },
      "leading-tight": { "$value": "1.25", "$type": "number" },
      "leading-normal": { "$value": "1.55", "$type": "number" }
    },
    "motion": {
      "duration-fast": { "$value": "120ms", "$type": "duration" },
      "duration-base": { "$value": "200ms", "$type": "duration" },
      "easing-standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" }
    }
  },
  "semantic": {
    "light": {
      "bg": { "$value": "{color.gray.0}" },
      "surface": { "$value": "{color.gray.50}" },
      "surface-raised": { "$value": "{color.gray.0}" },
      "border": { "$value": "{color.gray.200}" },
      "border-strong": { "$value": "{color.gray.300}" },
      "text": { "$value": "{color.gray.900}" },
      "text-muted": { "$value": "{color.gray.600}" },
      "text-subtle": { "$value": "{color.gray.500}" },
      "accent": { "$value": "{color.accent.600}" },
      "accent-hover": { "$value": "{color.accent.700}" },
      "accent-soft": { "$value": "{color.accent.100}" },
      "on-accent": { "$value": "{color.gray.0}" },
      "success": { "$value": "{color.success.600}" },
      "success-soft": { "$value": "{color.success.100}" },
      "danger": { "$value": "{color.danger.600}" },
      "danger-soft": { "$value": "{color.danger.100}" },
      "shadow-sm": { "$value": "0 1px 2px rgba(11, 16, 26, 0.06)" },
      "shadow-md": { "$value": "0 4px 12px rgba(11, 16, 26, 0.08)" }
    },
    "dark": {
      "bg": { "$value": "{color.gray.950}" },
      "surface": { "$value": "{color.gray.900}" },
      "surface-raised": { "$value": "{color.gray.800}" },
      "border": { "$value": "{color.gray.800}" },
      "border-strong": { "$value": "{color.gray.700}" },
      "text": { "$value": "{color.gray.50}" },
      "text-muted": { "$value": "{color.gray.300}" },
      "text-subtle": { "$value": "{color.gray.400}" },
      "accent": { "$value": "{color.accent.400}" },
      "accent-hover": { "$value": "{color.accent.300}" },
      "accent-soft": { "$value": "{color.accent.900}" },
      "on-accent": { "$value": "{color.gray.950}" },
      "success": { "$value": "{color.success.400}" },
      "success-soft": { "$value": "{color.success.900}" },
      "danger": { "$value": "{color.danger.400}" },
      "danger-soft": { "$value": "{color.danger.900}" },
      "shadow-sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.4)" },
      "shadow-md": { "$value": "0 4px 12px rgba(0, 0, 0, 0.5)" }
    }
  },
  "component": {
    "button-radius": { "$value": "{radius.md}" },
    "button-height": { "$value": "{size.control-md}" },
    "button-padding-x": { "$value": "{space.4}" },
    "input-radius": { "$value": "{radius.md}" },
    "input-height": { "$value": "{size.control-md}" },
    "card-radius": { "$value": "{radius.lg}" },
    "card-padding": { "$value": "{space.5}" },
    "badge-radius": { "$value": "{radius.full}" }
  },
  "contrast": {
    "$description": "Pairs checked at build time. Every pair must reach WCAG AA 4.5:1 in both themes.",
    "pairs": [
      ["text", "bg"], ["text", "surface"], ["text-muted", "bg"], ["text-muted", "surface"],
      ["text-subtle", "bg"], ["text-subtle", "surface"], ["accent", "bg"], ["accent", "surface"],
      ["on-accent", "accent"], ["on-accent", "accent-hover"], ["accent", "accent-soft"],
      ["success", "success-soft"], ["danger", "danger-soft"], ["danger", "bg"]
    ]
  }
}
