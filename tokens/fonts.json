  "editorial":  { "label": "Editorial",  "group": "serif", "fonts": "Newsreader + Inter",                     "title": "Thoughtful, magazine-style" },
  "elegant":    { "label": "Elegant",    "group": "serif", "fonts": "Playfair Display + Inter",               "title": "High contrast, fashion and luxury" },
  "warm":       { "label": "Warm",       "group": "serif", "fonts": "Fraunces + Inter",                       "title": "Soft old-style serif, food and craft" },
  "terminal":   { "label": "Terminal",   "group": "mono",  "fonts": "JetBrains Mono",                         "title": "Everything monospaced, for developer tools" }
