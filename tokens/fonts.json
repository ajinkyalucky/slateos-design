  "modern":     { "label": "Modern",     "group": "sans",  "fonts": "Manrope + JetBrains Mono",               "title": "Open, current and calm" },
  "clean":      { "label": "Clean",      "group": "sans",  "fonts": "DM Sans + JetBrains Mono",               "title": "Low contrast, geometric and tidy" },
  "startup":    { "label": "Startup",    "group": "sans",  "fonts": "Plus Jakarta Sans + JetBrains Mono",     "title": "Polished product marketing" },
  "geometric":  { "label": "Geometric",  "group": "sans",  "fonts": "Outfit + JetBrains Mono",                "title": "Circles, lines and confidence" },
  "corporate":  { "label": "Corporate",  "group": "sans",  "fonts": "IBM Plex Sans + JetBrains Mono",         "title": "Sober, trustworthy, enterprise" },
  "friendly":   { "label": "Friendly",   "group": "sans",  "fonts": "Nunito + JetBrains Mono",                "title": "Soft, warm and welcoming" },
  "expressive": { "label": "Expressive", "group": "sans",  "fonts": "Bricolage Grotesque + Inter",            "title": "Headlines with character" },
