{
  "name": "@ajinkyabhagwat/slateos",
  "version": "0.3.0",
  "description": "SlateOS: an open design system for the web. 181 components, 119 icons, three-layer tokens, light and dark themes. Plain CSS, no dependencies.",
  "keywords": [
    "design-system",
    "css",
    "ui",
    "components",
    "design-tokens",
    "dark-mode",
    "accessible"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Ajinkya Bhagwat",
  "homepage": "https://slateos.ajinkya.design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajinkyalucky/slateos-design.git"
  },
  "bugs": {
    "url": "https://github.com/ajinkyalucky/slateos-design/issues"
  },
  "files": [
    "dist"
  ],
  "style": "dist/slateos.css",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-native.mjs && node scripts/build-native-docs.mjs && node scripts/build-native-registry.mjs && node scripts/build-native-blocks.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "preview": "npm run build && python3 -m http.server 4173 -d public"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource-variable/jetbrains-mono": "5.2.5",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0"
  }
